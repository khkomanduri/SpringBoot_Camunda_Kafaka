    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_14wsgdq" name="DefaultFlow" sourceRef="Gateway_0epl5kk" targetRef="Activity_1u4k5g6" />
    <bpmn:sequenceFlow id="uvPath" name="uwPath" sourceRef="Gateway_0epl5kk" targetRef="uwTaskneeded">
      <bpmn:extensionElements />
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${uwFlag==true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="uwTaskneeded" name="uwTask needed" camunda:formRef="UWForm" camunda:formRefBinding="latest">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="extensionVariables" value="${InsuredDetails}" />
        </camunda:properties>
        <camunda:executionListener class="com.example.camundagreeting.listeners.UWProcessApplication" event="start" />
