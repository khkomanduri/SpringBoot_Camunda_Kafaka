  <bpmn:process id="vehicle_age_check" name="Vehicle Age Check" isExecutable="true" camunda:historyTimeToLive="P5D">
    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="extensionVariables" value="${execution.getVariables()}" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_0tqe4rc</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_0tqe4rc" sourceRef="StartEvent_1" targetRef="Activity_0s7vv6g" />
    <bpmn:serviceTask id="Activity_0s7vv6g" name="Vehicle Age Validation" camunda:class="com.example.camundagreeting.delegate.CaliculateVehicleAgeDeligate">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="InsuredDetails">
            <camunda:map>
              <camunda:entry key="insuredId">${insuredId}</camunda:entry>
              <camunda:entry key="vehicleMake">${vehicleMake}</camunda:entry>
              <camunda:entry key="vehicleModel">${vehicleModel}</camunda:entry>
              <camunda:entry key="vehicleVariant">${vehicleVariant}</camunda:entry>
              <camunda:entry key="dateOfFirstPurchase">${dateOfFirstPurchase}</camunda:entry>
              <camunda:entry key="uwFlag">${uwFlag}</camunda:entry>
            </camunda:map>
          </camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0tqe4rc</bpmn:incoming>
      <bpmn:outgoing>Flow_03jydma</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_End" name="End">
      <bpmn:incoming>Flow_1rp21ni</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_03jydma" name="UW Gate" sourceRef="Activity_0s7vv6g" targetRef="Gateway_0epl5kk">
      <bpmn:extensionElements />
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="Gateway_0epl5kk" name="UW Coditions" default="Flow_14wsgdq">
