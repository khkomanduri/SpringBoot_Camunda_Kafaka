              <camunda:entry key="insuredId">${insuredId}</camunda:entry>
              <camunda:entry key="vehicleMake">${vehicleMake}</camunda:entry>
              <camunda:entry key="vehicleModel">${vehicleModel}</camunda:entry>
              <camunda:entry key="vehicleVariant">${vehicleVariant}</camunda:entry>
              <camunda:entry key="dateOfFirstPurchase">${dateOfFirstPurchase}</camunda:entry>
              <camunda:entry key="uwFlag">${uwFlag}</camunda:entry>
            </camunda:map>
          </camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>uvPath</bpmn:incoming>
      <bpmn:outgoing>Flow_0c17td9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Event_1exytax" name="End">
      <bpmn:incoming>Flow_0c17td9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0c17td9" name="EndFlow" sourceRef="uwTaskneeded" targetRef="Event_1exytax" />
    <bpmn:sequenceFlow id="Flow_1rp21ni" name="EndFlow" sourceRef="Activity_1u4k5g6" targetRef="Event_End" />
    <bpmn:serviceTask id="Activity_1u4k5g6" name="uwTask Not Needed" camunda:class="com.example.camundagreeting.delegate.UWPassDeligate">
      <bpmn:incoming>Flow_14wsgdq</bpmn:incoming>
      <bpmn:outgoing>Flow_1rp21ni</bpmn:outgoing>
    </bpmn:serviceTask>
  </bpmn:process>
